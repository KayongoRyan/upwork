# MongoDB connection shared by the CPMIS portal stores and the Express API.
# Development uses the local database from `npm run mongo:local`; Atlas works too.
MONGODB_URI=mongodb://127.0.0.1:27017

# One database per portal. Each portal owns the collections for its work:
#   admin   -> projects, users, employees, documents, activity logs, settings, credentials
#   pm      -> tasks, calendar events, progress marks, cost reports, sessions
#   se      -> engineer reports, sessions
#   qs      -> bill of quantities, sessions
# Notifications live in the recipient portal's database.
MONGODB_DB_ADMIN=vertexa_admin
MONGODB_DB_PM=vertexa_pm
MONGODB_DB_SE=vertexa_se
MONGODB_DB_QS=vertexa_qs

# Demo sign-in passwords. Each seeded account uses the password for its role.
# Override these in a real deployment.
DEMO_PASSWORD_ADMIN=AdminDemo2026!
DEMO_PASSWORD_PM=PmDemo2026!
DEMO_PASSWORD_SE=SeDemo2026!
DEMO_PASSWORD_QS=QsDemo2026!

# Africa's Talking SMS for portal signup phone verification (OTP).
# Required for self-signup QR flows; sign-in with existing credentials still works without it.
AT_USERNAME=sandbox
AT_API_KEY=
AT_FROM=

# Temporary: show demo OTP in signup UI when SMS delivery/sender setup is pending.
OTP_DEMO_FALLBACK=false

# Base URL of the Express API in backend/. Used by /api/vertexa/inquiries
# (inquiry writes) and /api/vertexa/notifications (CPMIS inbox read-through).
# Development defaults to http://localhost:4000 when this is empty.
# Production must set it: without it inquiries fall back to the in-memory store
# and the CPMIS inboxes show only their demo notices.
VERTEXA_API_URL=http://localhost:4000

# Shared secret for admin API routes (inquiries ops, notifications).
# Passed by the Next.js BFF to Express as X-API-Key. Must match backend VERTEXA_API_KEY.
# Development defaults to dev-vertexa-api-key when unset.
VERTEXA_API_KEY=dev-vertexa-api-key

# Object storage for document uploads. Local stores files on disk; S3 can be added later.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/uploads
