# -----------------------------------------------------------------------------
# CPMIS / Vertexa environment configuration
# Copy to .env (repo root) and/or backend/.env as needed. Do not commit secrets.
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
TRUST_PROXY=false

# MongoDB connection (shared by CPMIS portal stores and Express API).
MONGODB_URI=mongodb://127.0.0.1:27017

# One database per portal (CPMIS portal stores).
MONGODB_DB_ADMIN=vertexa_admin
MONGODB_DB_PM=vertexa_pm
MONGODB_DB_SE=vertexa_se
MONGODB_DB_QS=vertexa_qs

# Legacy/shared Express DB name (inquiries/notifications collections).
MONGODB_DB=vertexa_cpmis

# Express CORS origins (comma-separated). In production, set explicit HTTPS origins only.
CORS_ORIGINS=http://localhost:3030,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Shared admin/API secret. BFF sends it as X-API-Key/Bearer. Required in production.
VERTEXA_API_KEY=dev-vertexa-api-key

# Base URL of Express API used by Next.js BFF proxies. Required in production.
VERTEXA_API_URL=http://localhost:4000
# Optional alias supported by BFF:
# CPMIS_API_URL=http://localhost:4000

# Demo sign-in passwords (seeded accounts). Override in real deployments.
DEMO_PASSWORD_ADMIN=AdminDemo2026!
DEMO_PASSWORD_PM=PmDemo2026!
DEMO_PASSWORD_SE=SeDemo2026!
DEMO_PASSWORD_QS=QsDemo2026!

# Supabase Auth email OTP for portal signup verification.
# Use the project base URL (not /rest/v1). Enable Email auth in Supabase and add
# {{ .Token }} to the Magic Link and Confirm signup email templates so users can
# read the 6-digit code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Newer publishable key alias supported instead of SUPABASE_ANON_KEY:
# SUPABASE_PUBLISHABLE_KEY=
SUPABASE_EMAIL_OTP_TIMEOUT_MS=10000

# TEMPORARY: show demo OTP in signup UI when email delivery is not configured.
# Must be false in production.
OTP_DEMO_FALLBACK=false

# Object storage for document uploads.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/uploads

# Public inquiry rate limit (Express).
INQUIRY_RATE_LIMIT_WINDOW_MS=600000
INQUIRY_RATE_LIMIT_MAX=20

# Internal FastAPI service (health/worker coordination/jobs).
INTERNAL_SERVICE_URL=http://127.0.0.1:4010
INTERNAL_SERVICE_KEY=dev-internal-service-key
INTERNAL_SERVICE_TIMEOUT_MS=10000
