PORT=4000
# Local MongoDB (default) or MongoDB Atlas connection string:
MONGODB_URI=mongodb://127.0.0.1:27017
# Example Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=vertexa_cpmis
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3030

# Shared secret for admin routes (inquiries list/detail/update, notifications).
# The Next.js BFF sends this as X-API-Key. Required in production.
VERTEXA_API_KEY=dev-vertexa-api-key

# Public inquiry creation rate limit (POST /api/v1/inquiries)
INQUIRY_RATE_LIMIT_WINDOW_MS=600000
INQUIRY_RATE_LIMIT_MAX=20